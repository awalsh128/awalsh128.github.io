#!/usr/bin/env bash
# 1. Sync the homepage project list and project logos with the repositories pinned on GitHub.
# 2. Regenerate content/resume.pdf when the resume changes.
# Enable once per clone with: git config core.hooksPath .githooks

root="$(git rev-parse --show-toplevel)"
index="content/_index.md"
logos="assets/img/projects"

if ! python3 "${root}/scripts/update_projects.py"; then
  echo "pre-commit: skipping project sync; commit continues with the existing list." >&2
elif [[ -n "$(git -C "${root}" status --porcelain -- "${index}" "${logos}")" ]]; then
  # -A also stages logos removed for repositories that are no longer pinned.
  git -C "${root}" add -A -- "${index}" "${logos}"
  echo "pre-commit: staged updated ${index} and ${logos}/." >&2
fi

# Regenerate the PDF resume when its source, layout, or styling is part of the commit.
# Renders the working tree, so stage the resume changes you want reflected in the PDF.
pdf="content/resume.pdf"
if git -C "${root}" diff --cached --quiet -- content/resume.md layouts/_default/resume.html assets/css/custom/; then
  :
elif "${root}/scripts/resume_to_pdf.sh"; then
  git -C "${root}" add -- "${pdf}"
  echo "pre-commit: staged regenerated ${pdf}." >&2
else
  echo "pre-commit: skipping PDF resume; commit continues with the existing ${pdf}." >&2
fi
