#!/usr/bin/env bash
# 1. Sync the homepage project list and project logos with the repositories pinned on GitHub.
# 2. Refresh the resume page's LinkedIn recommendations from the newest LinkedIn data export in ~/Downloads.
# 3. Regenerate content/resume.pdf when the resume changes.
# 4. Rebuild post download archives (e.g. scaffold.tar.gz) when the folder they're built from changes.
# Enable once per clone with: git config core.hooksPath .githooks

root="$(git rev-parse --show-toplevel)"
index="content/_index.md"
logos="assets/img/projects"

if ! python3 "${root}/scripts/update_projects.py"; then
  echo "pre-commit: skipping project sync; commit continues with the existing list." >&2
elif [[ -n "$(git -C "${root}" status --porcelain -- "${index}" "${logos}")" ]]; then
  # -A also stages logos removed for repositories that are no longer pinned.
  git -C "${root}" add -A -- "${index}" "${logos}"
  echo "pre-commit: staged updated ${index} and ${logos}/." >&2
fi

# Refresh the LinkedIn recommendations shown on the resume page (not in the PDF). Without an export it changes nothing.
recommendations="data/linkedin_recommendations.json"
if ! python3 "${root}/scripts/update_recommendations.py"; then
  echo "pre-commit: skipping recommendations sync; commit continues with the existing list." >&2
elif [[ -n "$(git -C "${root}" status --porcelain -- "${recommendations}")" ]]; then
  git -C "${root}" add -- "${recommendations}"
  echo "pre-commit: staged updated ${recommendations}." >&2
fi

# Regenerate the PDF resume when its source, layout, or styling is part of the commit.
# Renders the working tree, so stage the resume changes you want reflected in the PDF.
pdf="content/resume.pdf"
if git -C "${root}" diff --cached --quiet -- content/resume.md layouts/_default/resume.html assets/css/custom/; then
  :
elif "${root}/scripts/resume_to_pdf.sh"; then
  git -C "${root}" add -- "${pdf}"
  echo "pre-commit: staged regenerated ${pdf}." >&2
else
  echo "pre-commit: skipping PDF resume; commit continues with the existing ${pdf}." >&2
fi

# Rebuild a post's download archive when files in the folder it's built from are part of the commit.
for archive in "${root}"/content/posts/*/*.tar.gz; do
  [[ -e "${archive}" ]] || continue
  folder="${archive%.tar.gz}"
  rel="${archive#"${root}/"}"
  if [[ -d "${folder}" ]] && ! git -C "${root}" diff --cached --quiet -- "${folder}"; then
    "${root}/scripts/pack_bundle_archives.sh" "${folder}" >/dev/null
    git -C "${root}" add -- "${rel}"
    echo "pre-commit: staged rebuilt ${rel}." >&2
  fi
done
